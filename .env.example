# ====================================================================
# BIẾN MÔI TRƯỜNG HỆ THỐNG CRM - ĐỀ 4 KTHP
# ====================================================================

# 1. Cấu hình Cơ sở dữ liệu PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=crm_secret_pass_2026

# 2. Cấu hình pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@crm.com
PGADMIN_DEFAULT_PASSWORD=AdminPass@2026

# Cấu hình Nginx Gateway
NGINX_PORT=8080

# 3. Cấu hình Ứng dụng CRM (Node.js Express)
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# 4. Cấu hình Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

